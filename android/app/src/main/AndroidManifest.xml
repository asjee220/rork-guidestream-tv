<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: without this the tracked-game notification
         posts as an ordinary ongoing one and is never promoted to the status
         bar chip or the always-on display. Harmless on older releases. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- SpeechRecognizer package visibility (required on Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.roku.remote" />

        <!--
          GUI-77: sports broadcaster apps the Watch button launches when the
          broadcaster does not claim its own https URL as a verified App Link.
          getLaunchIntentForPackage returns null without this visibility on
          Android 11+, even when the app is installed. Every package here was
          checked against its live Play Store listing.
        -->
        <package android:name="com.espn.score_center" />
        <package android:name="com.foxsports.android" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.cbs.app" />
        <package android:name="com.handmark.sportcaster" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.bleacherreport.android.teamstream" />
        <package android:name="com.gotv.nflgamecenter.us.lite" />
        <package android:name="com.nbaimd.gametime.nba2011" />
        <package android:name="com.bamnetworks.mobile.android.gameday.atbat" />
        <package android:name="com.nhl.gc1112.free" />
        <package android:name="tv.fubo.mobile" />
        <package android:name="com.sling" />
        <package android:name="com.dazn" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
    </queries>

    <application
        android:name=".GuideStreamTVApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Guide Stream TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.RorkApp">

        <!-- Deep link intent filter for guidestream:// -->
        <!-- configChanges keeps MainActivity alive across rotation. MainScreen
             holds selectedTab in a plain remember, so without this a rotation
             would destroy and recreate the activity and dump the user out of
             Reels back onto Home mid-reel. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.RorkApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="guidestream" />
            </intent-filter>
        </activity>

        <!-- FCM Messaging Service -->
        <service
            android:name=".push.GuideStreamFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- AdMob App ID — resolved from the ANDROID_ADMOB_APP_ID manifest
             placeholder (see app/build.gradle.kts); test app id fallback. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ANDROID_ADMOB_APP_ID}" />

        <!-- Default FCM notification channel: notification-payload pushes are
             rendered by the Firebase SDK without invoking onMessageReceived;
             any message arriving without an explicit channel id resolves to
             this existing channel instead of being silently dropped. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="gs_episodes" />

        <!-- "Stop tracking" on the live-score notification. The Android
             counterpart of iOS's StopTrackingGameIntent: runs in the app's
             process without bringing the app forward. -->
        <receiver
            android:name=".sports.live.LiveScoreActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rork.guidestreamtvandroid.LIVE_SCORE_STOP" />
            </intent-filter>
        </receiver>

        <!-- Glance Widget -->
        <receiver
            android:name=".widget.GuideStreamWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/guide_stream_widget_info" />
        </receiver>
    </application>

</manifest>
