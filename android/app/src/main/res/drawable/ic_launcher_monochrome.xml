<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons. Same geometry as
  ic_launcher_foreground, flattened to a single opaque colour: the launcher
  ignores the colour and tints the silhouette from the user's wallpaper
  palette, so only the alpha shape matters here.

  Scaled slightly smaller (0.86) than the colour foreground because themed
  icons are rendered without a contrasting background and read better with a
  little more breathing room.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.86"
        android:scaleY="0.86">

        <path
            android:pathData="M801.48,515.54 A289.5,289.5 0 1 1 658.14,262.09"
            android:strokeWidth="78"
            android:strokeLineCap="round"
            android:strokeColor="#FFFFFFFF"
            android:fillColor="@android:color/transparent" />

        <path
            android:pathData="M538,394 L800,512 L538,630 Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
